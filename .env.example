# ------------------------------------------------------------------
# Copy to .env.local for local development. Never commit real values.
# In production, set these in Vercel: Project Settings > Environment Variables.
# ------------------------------------------------------------------

# Public URL of the deployed site, without a trailing slash.
# Used for canonical URLs, Open Graph tags, the sitemap, robots.txt, JSON-LD
# and the contact card. Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=https://www.example.co.tz

# PostgreSQL connection string.
# Local: the Docker database from docker-compose.yml (npm run db:up).
# Production: the Neon connection string added by the Vercel integration.
DATABASE_URL=postgres://bfl:bfl_local_dev@127.0.0.1:5433/bfl

# Administrator account, created by `npm run db:seed` if it does not exist.
# The initial password must be at least 12 characters. Change it from the
# admin panel after the first login; it is stored only as an Argon2id hash.
ADMIN_EMAIL=admin@example.co.tz
ADMIN_INITIAL_PASSWORD=change-me-to-a-long-password

# Vercel Blob read-write token for image and document uploads.
# Added automatically when you connect a Blob store to the Vercel project.
# Leave empty in local development to store uploads on disk instead
# (development only; production refuses to run without Blob).
BLOB_READ_WRITE_TOKEN=

# Secret that Vercel Cron sends to the upload clean-up route
# (/api/cron/cleanup-uploads). Any long random string.
CRON_SECRET=change-me-to-a-long-random-string
